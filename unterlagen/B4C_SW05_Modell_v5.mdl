{UTF-8}
********************************************************
	.Nachfrage
********************************************************~
		Nachfrage nach der betrachteten Produktgruppe (verpackte Snacks). Bewusst konstant, damit die Wirkung der Lieferung sichtbar wird.
	|

Kundenbesuche=
	700
	~	Besuch/Week [0,1400,50]
	~	Charter: rund 700 Kundinnen und Kunden pro Woche, als Besuche interpretiert. Events und Saison bewusst nicht modelliert.
	|

Kaufmenge je Besuch=
	0.4
	~	Produkt/Besuch [0,1,0.05]
	~	Annahme: im Mittel 0.4 Snacks pro Besuch. Ergibt 280 Snacks pro Woche.
	|

Nachfrage=
	Kundenbesuche*Kaufmenge je Besuch
	~	Produkt/Week
	~	Wie viele Snacks die Gäste kaufen möchten, unabhängig davon, ob genug Ware da ist. Basis 280 pro Woche.
	|

********************************************************
	.Prognose
********************************************************~
		Wie der Inhaber die Nachfrage einschätzt: aus dem, was er verkauft hat, und aus Ausverkäufen, soweit er sie bemerkt.
	|

Erfasster Anteil Fehlmenge=
	0.5
	~	Dmnl [0,1,0.25]
	~	0.5 = heute: Der Inhaber merkt Ausverkäufe, schätzt die verpasste Menge aber nur grob (Augenmass). 1 = Strichliste (Signal S1): Jede verpasste Nachfrage wird gezählt.
	|

Erfasste Nachfrage=
	Verkaufsmenge+Erfasster Anteil Fehlmenge*Fehlmenge
	~	Produkt/Week
	~	Was der Inhaber von der Nachfrage wahrnimmt: Verkäufe plus der Teil der Fehlmenge, den er bemerkt.
	|

Planungszeit=
	1
	~	Week [0.25,4,0.25]
	~	Der Erfahrungswert passt sich über etwa eine Woche an (wöchentliche Bestellung).
	|

Nachfrageprognose=
	SMOOTHI(Erfasste Nachfrage,Planungszeit,Nachfrage)
	~	Produkt/Week
	~	Erfahrungswert des Inhabers. Folgt der erfassten Nachfrage mit Verzögerung. Start 280.
	|

********************************************************
	.Bestellregel
********************************************************~
		Vorgeschlagene Regel: Prognose plus Korrektur der Lücke im Lager und bei der Ware unterwegs (Signal S2).
	|

Zielreichweite=
	0.75
	~	Week [0.25,2,0.25]
	~	Normale Reserve: Das Lager deckt 0.75 Wochen (gut 5 Tage) Nachfrage, etwas mehr als die normale Lieferzeit.
	|

Sollbestand=
	Nachfrageprognose*Vorgesteuerte Reichweite
	~	Produkt
	~	Angestrebter Warenbestand. Normal 280 x 0.75 = 210. Bei Lieferwarnung vorübergehend höher.
	|

Bestandslücke=
	Sollbestand-Warenbestand
	~	Produkt
	~	Positiv = zu wenig Ware im Lager.
	|

Geplante Angebotsmenge=
	Nachfrageprognose*(1+Zielreichweite/Mittlere Verlustzeit)
	~	Produkt/Week
	~	Erwarteter Verbrauch: Prognose plus erwarteter Schwund am normalen Lager (1 Prozent pro Woche). Normal 282.1.
	|

Soll Ware unterwegs=
	Geplante Angebotsmenge*Basislieferzeit
	~	Produkt
	~	So viel sollte bei normaler Lieferzeit bestellt und unterwegs sein. Der Inhaber rechnet mit der normalen Lieferzeit, nicht mit einer Störung. Normal 141.05.
	|

Lücke Ware unterwegs=
	Soll Ware unterwegs-Ware unterwegs
	~	Produkt
	~	Positiv = zu wenig Ware bestellt und unterwegs.
	|

Anpassungszeit=
	1
	~	Week [0.25,4,0.25]
	~	Lücken werden über etwa eine Woche ausgeglichen (wöchentliche Bestellung).
	|

Bestellmenge=
	MAX(0,Geplante Angebotsmenge+(Bestandslücke+Lücke Ware unterwegs)/Anpassungszeit)
	~	Produkt/Week
	~	Bestellt wird der erwartete Verbrauch plus die Lücke im Lager und bei der Ware unterwegs (Signal S2). Nie negativ.
	|

********************************************************
	.Lieferung
********************************************************~
		Lieferant: normale Lieferzeit und eine Lieferstörung in Woche 14 bis 16 (Szenario).
	|

Beginn Lieferstörung=
	14
	~	Week [0,26,1]
	~	Testzeitpunkt der Lieferstörung, frei gewählt.
	|

Ende Lieferstörung=
	16
	~	Week [0,26,1]
	~	Ende der Lieferstörung.
	|

Lieferstörung aktiv=
	STEP(1,Beginn Lieferstörung)-STEP(1,Ende Lieferstörung)
	~	Dmnl
	~	1 während der Lieferstörung, sonst 0.
	|

Lieferausfallanteil=
	0.5
	~	Dmnl [0,1,0.1]
	~	Während der Störung sagt der Lieferant nur die Hälfte neuer Bestellungen zu. 0 = keine Störung.
	|

Lieferfähigkeit=
	1-Lieferausfallanteil*Lieferstörung aktiv
	~	Dmnl
	~	Zugesagter Anteil neuer Bestellungen. Nicht zugesagte Ware verfällt.
	|

Basislieferzeit=
	0.5
	~	Week [0.25,2,0.25]
	~	Normale Lieferzeit: 3.5 Tage.
	|

Lieferzeitverlängerung=
	1
	~	Week [0,2,0.25]
	~	Während der Störung dauert die Lieferung 1.5 statt 0.5 Wochen. 0 = keine Störung.
	|

Lieferzeit=
	Basislieferzeit+Lieferzeitverlängerung*Lieferstörung aktiv
	~	Week
	~	Tatsächliche Lieferzeit. Verzögerung zwischen Ware unterwegs und Liefermenge.
	|

********************************************************
	.Vorsteuerung
********************************************************~
		Feedforward: Die angekündigte Störung wird gemessen, bevor sie wirkt, und die Reserve vorher erhöht (Signal S6).
	|

Vorsteuerung aktiv=
	0
	~	Dmnl [0,1,1]
	~	0 = heutige Praxis. 1 = Bei einer Vorwarnung des Lieferanten wird die Reserve vorübergehend erhöht.
	|

Vorwarnzeit=
	2
	~	Week [0,4,0.5]
	~	Annahme: Der Lieferant kündigt Engpässe (Feiertage, Betriebsferien, Lieferprobleme) 2 Wochen vorher an.
	|

Lieferwarnung=
	Vorsteuerung aktiv*(STEP(1,Beginn Lieferstörung-Vorwarnzeit)-STEP(1,Ende Lieferstörung))
	~	Dmnl
	~	Störgrösse, gemessen vor ihrer Wirkung: 1 von der Ankündigung bis zum Ende der Störung.
	|

Zusatzreichweite bei Warnung=
	0.75
	~	Week [0,2,0.25]
	~	Zusätzliche Reserve während der Warnung. 0.75 + 0.75 = 1.5 Wochen, so lange wie die Lieferzeit in der Störung.
	|

Vorgesteuerte Reichweite=
	Zielreichweite+Zusatzreichweite bei Warnung*Lieferwarnung
	~	Week
	~	Ohne Warnung 0.75 Wochen, mit Warnung 1.5 Wochen.
	|

********************************************************
	.Warenfluss
********************************************************~
		Bestände und Flüsse der Snacks.
	|

Lieferzusage=
	Bestellmenge*Lieferfähigkeit
	~	Produkt/Week
	~	Zufluss in Ware unterwegs: vom Lieferanten zugesagte Ware.
	|

Ware unterwegs=
	INTEG(Lieferzusage-Liefermenge,Soll Ware unterwegs)
	~	Produkt
	~	Bestellte, zugesagte, noch nicht gelieferte Ware. Start 141.05.
	|

Liefermenge=
	MAX(0,Ware unterwegs)/Lieferzeit
	~	Produkt/Week
	~	Gelieferte Ware. Verzögerung erster Ordnung.
	|

Abverkaufszeit=
	0.25
	~	Week [0.05,1,0.05]
	~	Unter 0.25 Wochen Reichweite (70 Stück) fehlen einzelne Sorten, nicht mehr jede Nachfrage kann bedient werden.
	|

Warenverfügbarkeit=
	MIN(1,XIDZ(MAX(0,Warenbestand),Nachfrage*Abverkaufszeit,1))
	~	Dmnl
	~	Anteil der Nachfrage, der bedient werden kann (0 bis 1).
	|

Verkaufsmenge=
	Nachfrage*Warenverfügbarkeit
	~	Produkt/Week
	~	Verkauft wird der Teil der Nachfrage, für den Ware da ist.
	|

Fehlmenge=
	Nachfrage*(1-Warenverfügbarkeit)
	~	Produkt/Week
	~	Gäste, die keinen Snack bekommen. Verloren, sie kaufen nicht später nach.
	|

Mittlere Verlustzeit=
	100
	~	Week [4,200,4]
	~	1 Prozent des Lagers pro Woche verdirbt oder wird beschädigt.
	|

Verluste=
	MAX(0,Warenbestand)/Mittlere Verlustzeit
	~	Produkt/Week
	~	Abgelaufene oder beschädigte Ware.
	|

Warenbestand=
	INTEG(Liefermenge-Verkaufsmenge-Verluste,Sollbestand)
	~	Produkt
	~	Verkaufsfähige Snacks im Café. Start 210.
	|

********************************************************
	.Kennzahlen
********************************************************~
		Zähler für den Szenariovergleich über 26 Wochen.
	|

Kumulierte Fehlmenge=
	INTEG(Fehlmenge,0)
	~	Produkt
	~	Verlorene Verkäufe seit Start.
	|

Kumulierte Verluste=
	INTEG(Verluste,0)
	~	Produkt
	~	Verdorbene Ware seit Start.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME=
	26
	~	Week
	~	26 Wochen Simulationshorizont.
	|

INITIAL TIME=
	0
	~	Week
	~	Start der Simulation.
	|

SAVEPER=
	TIME STEP
	~	Week [0,?]
	~	Ausgabeintervall.
	|

TIME STEP=
	0.03125
	~	Week [0,?]
	~	Rechenschritt 1/32 Woche.
	|

